# ===== ZORUNLU AYARLAR =====
# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=buraya_bot_tokeni
# Discord Developer Portal > General Information > Application ID
CLIENT_ID=123456789012345678
# Sunucu (guild) ID'si
GUILD_ID=123456789012345678
# "Sunucuya Giriş Yap" butonunun gönderileceği kanalın ID'si
GIRIS_KANAL_ID=123456789012345678
# Doğrulama loglarının atılacağı kanalın ID'si
LOG_KANAL_ID=123456789012345678

# ===== ROL AYARLARI =====
# Roller ID ile belirtilirse ID kullanılır, boş bırakılırsa isme göre aranır.
# Başlangıç rolü (yeni gelenlere otomatik verilir)
KIMSESIZ_ROL_ID=
KIMSESIZ_ROL_ADI=Kimsesiz
# Kalıcı / asıl üye rolü (doğrulama sonrası verilir)
UYE_ROL_ID=
UYE_ROL_ADI=Üye

# ===== OPSİYONEL AYARLAR =====
# Kod oluşturma kanalının ID'si. Doluysa /kod-olustur sadece bu kanalda çalışır
# ve /kod-paneli-kur "Kod Oluştur" butonunu bu kanala gönderir.
KOD_KANAL_ID=
# Doluysa sadece bu rollerden birine sahip kişiler kod oluşturabilir.
# Birden fazla rol için ID'leri virgülle ayır (boşluk bırakmadan):
# KOD_OLUSTURAN_ROL_ID=111111111111111111,222222222222222222
# Boşsa "Kimsesiz" rolü olmayan herkes kod oluşturabilir.
KOD_OLUSTURAN_ROL_ID=
# Bir kişinin aynı anda sahip olabileceği geçerli (kullanılmamış) kod sayısı
KISI_BASINA_MAKS_AKTIF_KOD=5
